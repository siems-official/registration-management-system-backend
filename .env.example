NODE_ENV=production
PORT=5000

# MongoDB connection string (required for non-test runtimes)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>

# JWT (required)
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Step-1 (password-only) token TTL before TOTP verification. Keep short.
PREAUTH_JWT_EXPIRES_IN=5m
ADMIN_2FA_ISSUER=AlumniEventPlatform

# SSLCommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_SUCCESS_URL=
SSLCOMMERZ_FAIL_URL=
SSLCOMMERZ_CANCEL_URL=
SSLCOMMERZ_IPN_URL=
# DEV ONLY: simulate the SSLCommerz gateway (init/validation/refund return
# canned success). Never enable in production. Logs a loud warning at startup.
SSLCOMMERZ_MOCK=false

# SMTP (mail delivery for ticket confirmations)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Event Registration <no-reply@example.com>"

# SMS provider credentials — placeholder, to be filled in later
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=2
# Optional; comma-separated whitelist of origins for CORS (empty disables CORS filtering)
ALLOWED_ORIGINS=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_STRICT_MAX=5

# Background queue worker (in-process)
QUEUE_POLL_INTERVAL_MS=5000
QUEUE_MAX_ATTEMPTS=5

LOG_LEVEL=info