NODE_ENV=production
PORT=5000

# MongoDB connection string (required for non-test runtimes)
MONGO_URI=mongodb+srv://sumonsmartpathshala_db_user:xorMorC5eGSZnNCP@m-cluster.otatmvu.mongodb.net/?appName=m-cluster 

# JWT (required)
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Step-1 (password-only) token TTL before TOTP verification. Keep short.
PREAUTH_JWT_EXPIRES_IN=5m
ADMIN_2FA_ISSUER=AlumniEventPlatform

# CellFin (Islami Bank) — replaces SSLCommerz
CELLFIN_MERCHANT_ID=
# Plaintext password provided by Islami Bank. Shipped with the request as
# SHA-512(password + correlationId). Never logged.
CELLFIN_PASSWORD=
# Shop/merchant display name shown to the payer (order.merchant).
CELLFIN_MERCHANT_NAME=
CELLFIN_IS_LIVE=false
# UAT base: https://staging.islamibankbd.com:8259
# Prod base: https://cellfinpay.islamibankbd.com
# Optional override for the API base URL (testing/proxies).
CELLFIN_ALLOW_OVERRIDE_URL=
# The four callback URLs must be registered with Islami Bank at onboarding and
# must match what this server actually exposes (/api/payment/CellFin*).
CELLFIN_SUCCESS_URL=
CELLFIN_FAIL_URL=
CELLFIN_CANCEL_URL=
CELLFIN_IPN_URL=
# DEV ONLY: simulate the CellFin gateway (token/status return canned success).
# Never enable in production. Logs a loud warning at startup.
CELLFIN_MOCK=false

# SMTP (mail delivery for ticket confirmations)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Event Registration <no-reply@example.com>"

# SMS provider credentials — placeholder, to be filled in later
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=2
# Optional; comma-separated whitelist of origins for CORS (empty disables CORS filtering)
ALLOWED_ORIGINS=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_STRICT_MAX=5

# Background queue worker (in-process)
QUEUE_POLL_INTERVAL_MS=5000
QUEUE_MAX_ATTEMPTS=5

LOG_LEVEL=info